<?xml version="1.0" encoding="utf-8"?>
<!-- res/color/chip_text_selector.xml
     Couleur du TEXTE des chips selon leur état coché / non coché.
     Utilisé dans tous les ChipGroup via :
         android:textColor="@color/chip_text_selector"  -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Coché → texte teal foncé (#085041) -->
    <item
        android:color="@color/chip_checked_text"
        android:state_checked="true" />

    <!-- Non coché (état par défaut) → texte gris (#666666) -->
    <item android:color="@color/chip_unchecked_text" />

</selector>