<?xml version="1.0" encoding="utf-8"?>
<!-- item_ingredient_saisi.xml
     Structure : [QUANTITÉ | UNITÉ]  nom de l'ingrédient
     L'unité est fixe (non modifiable) — déterminée par la BD
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="8dp">

    <!-- Encadré quantité + unité — un seul bloc bordé -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_qty_box">

        <!-- Champ numérique de quantité — modifiable par l'utilisateur -->
        <EditText
            android:id="@+id/etQuantite"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:inputType="numberDecimal"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:background="@null"
            android:paddingHorizontal="4dp"
            android:imeOptions="actionDone"
            android:maxLines="1"
            tools:text="3" />

        <!-- Séparateur vertical entre quantité et unité -->
        <View
            android:id="@+id/dividerQtyUnit"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"
            android:background="@color/border_secondary"
            android:visibility="visible" />

        <!-- Unité fixe en texte — non modifiable -->
        <TextView
            android:id="@+id/tvUnite"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            tools:text="g" />

        <!-- Spinner caché — conservé pour compatibilité mais non utilisé -->
        <Spinner
            android:id="@+id/spinnerUnite"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@null"
            android:paddingHorizontal="6dp"
            android:textSize="11sp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Nom de l'ingrédient -->
    <TextView
        android:id="@+id/tvNomIngredient"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:ellipsize="end"
        android:maxLines="1"
        android:layout_marginStart="10dp"
        tools:text="tomates" />

</LinearLayout>