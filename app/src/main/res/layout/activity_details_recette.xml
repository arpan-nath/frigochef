<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".view.activities.DetailRecetteActivity">

    <!-- AppBar avec image hero qui se replie au défilement -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:background="@color/white"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:contentScrim="@color/white"
            app:titleEnabled="false">

            <!-- Image hero de la recette -->
            <ImageView
                android:id="@+id/ivRecetteHero"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.7"
                android:contentDescription="Image de la recette" />

            <!-- Badge de score de compatibilité (visible si arrivé depuis ResultatsActivity) -->
            <TextView
                android:id="@+id/tvScoreHero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="12dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_score_badge"
                android:visibility="gone"
                app:layout_collapseMode="pin"
                tools:text="92% compatible"
                tools:visibility="visible" />

            <!-- Toolbar avec bouton retour uniquement -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:layout_gravity="top"
                app:layout_collapseMode="pin"
                app:navigationIcon="@drawable/ic_arrow_left_circle"
                app:navigationContentDescription="Retour" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Corps scrollable de la page de détail -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="18dp"
            android:paddingBottom="32dp">

            <!-- Nom de la recette -->
            <TextView
                android:id="@+id/tvNomRecette"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginBottom="6dp"
                tools:text="Poulet yassa" />

            <!-- Description courte -->
            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingMultiplier="1.5"
                android:layout_marginBottom="16dp"
                tools:text="Poulet mariné à l'oignon et au citron, mijoté lentement pour une saveur profonde et parfumée." />

            <!-- Grille de stats : temps / difficulté / type repas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <!-- Carte Temps -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_stat_card"
                    android:padding="10dp"
                    android:layout_marginEnd="6dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_clock"
                        android:layout_marginBottom="3dp"
                        android:contentDescription="Temps" />

                    <TextView
                        android:id="@+id/tvTempsPrep"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        tools:text="50 min" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Préparation"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

                <!-- Carte Difficulté -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_stat_card"
                    android:padding="10dp"
                    android:layout_marginEnd="6dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_flame"
                        android:layout_marginBottom="3dp"
                        android:contentDescription="Difficulté" />

                    <TextView
                        android:id="@+id/tvDifficulte"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        tools:text="Moyen" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Difficulté"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

                <!-- Carte Type repas -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_stat_card"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_utensils"
                        android:layout_marginBottom="3dp"
                        android:contentDescription="Type de repas" />

                    <TextView
                        android:id="@+id/tvTypeRepas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        tools:text="Dîner" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Type repas"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

            </LinearLayout>

            <!-- Pills qualitatives : diète + cuisine + portions -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupPills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:chipSpacingHorizontal="5dp"
                app:chipSpacingVertical="4dp" />

            <!-- Séparateur -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/border_tertiary"
                android:layout_marginBottom="16dp" />

            <!-- Barre de compatibilité (visible si arrivé depuis ResultatsActivity) -->
            <LinearLayout
                android:id="@+id/layoutCompatibilite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="5dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Compatibilité avec vos ingrédients"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvPourcentageCompatibilite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#27500A"
                        tools:text="75% (4/6)" />

                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressBarCompatibilite"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:progress="75"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:progressTint="#639922"
                    android:progressBackgroundTint="@color/border_tertiary"
                    android:layout_marginBottom="16dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/border_tertiary"
                    android:layout_marginBottom="16dp" />

            </LinearLayout>

            <!-- Section Ingrédients -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_basket"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="Ingrédients" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ingrédients"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

            </LinearLayout>

            <!-- Liste des ingrédients (RecyclerView) -->
            <!-- LinearLayoutManager non-scrollable imbriqué dans NestedScrollView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvIngredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="20dp"
                tools:listitem="@layout/item_ingredient_detail" />

            <!-- Séparateur -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/border_tertiary"
                android:layout_marginBottom="16dp" />

            <!-- Section Instructions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_list_numbers"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="Instructions" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Instructions"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

            </LinearLayout>

            <!-- Étapes d'instructions (RecyclerView) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_instruction_step" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>