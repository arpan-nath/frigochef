<?xml version="1.0" encoding="utf-8"?>
<!-- fragment_filtres_panel.xml -->
<!-- Utilisé comme BottomSheetDialogFragment ou DrawerLayout dans ResultatsActivity -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Poignée du bottom sheet -->
    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_sheet_handle"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp" />

    <!-- En-tête du panneau -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Filtres"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <ImageButton
            android:id="@+id/btnFermerPanel"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_close_btn"
            android:src="@drawable/ic_close"
            android:padding="6dp"
            android:contentDescription="Fermer le panneau" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/border_tertiary" />

    <!-- Corps scrollable du panneau -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="8dp">

            <!-- Section : Mes ingrédients -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MES INGRÉDIENTS"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupMesIngredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:chipSpacingHorizontal="4dp"
                app:chipSpacingVertical="3dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/border_tertiary"
                android:layout_marginBottom="14dp" />

            <!-- Section : Difficulté -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DIFFICULTÉ"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupDifficulte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:chipSpacingHorizontal="4dp"
                app:singleSelection="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFacile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Facile"
                    android:textSize="10sp"
                    android:checkable="true"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    style="@style/Widget.MaterialComponents.Chip.Filter" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMoyen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Moyen"
                    android:textSize="10sp"
                    android:checkable="true"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    style="@style/Widget.MaterialComponents.Chip.Filter" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDifficile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Difficile"
                    android:textSize="10sp"
                    android:checkable="true"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    style="@style/Widget.MaterialComponents.Chip.Filter" />

            </com.google.android.material.chip.ChipGroup>

            <!-- Section : Type de repas -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TYPE DE REPAS"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupTypeRepas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:chipSpacingHorizontal="4dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDejeuner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Déjeuner"
                    android:textSize="10sp"
                    android:checkable="true"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    style="@style/Widget.MaterialComponents.Chip.Filter" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDiner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dîner"
                    android:textSize="10sp"
                    android:checkable="true"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    style="@style/Widget.MaterialComponents.Chip.Filter" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSouper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Souper"
                    android:textSize="10sp"
                    android:checkable="true"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    style="@style/Widget.MaterialComponents.Chip.Filter" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCollation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Collation"
                    android:textSize="10sp"
                    android:checkable="true"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    style="@style/Widget.MaterialComponents.Chip.Filter" />

            </com.google.android.material.chip.ChipGroup>

            <!-- Section : Régime alimentaire -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RÉGIME ALIMENTAIRE"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupRegime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:chipSpacingHorizontal="4dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipVegetarien"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Végétarien"
                    android:textSize="10sp"
                    android:checkable="true"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    style="@style/Widget.MaterialComponents.Chip.Filter" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipVegan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Végane"
                    android:textSize="10sp"
                    android:checkable="true"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    style="@style/Widget.MaterialComponents.Chip.Filter" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSansGluten"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sans gluten"
                    android:textSize="10sp"
                    android:checkable="true"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    style="@style/Widget.MaterialComponents.Chip.Filter" />

            </com.google.android.material.chip.ChipGroup>

            <!-- Section : Temps de préparation -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TEMPS DE PRÉPARATION MAX"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.05"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="5 min"
                    android:textSize="9sp"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvTempsMaxValeur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    tools:text="55 min" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="120 min"
                    android:textSize="9sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="end" />

            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderTempsMax"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:valueFrom="5"
                android:valueTo="120"
                android:value="60"
                android:stepSize="5"
                app:thumbColor="#0F6E56"
                app:trackColorActive="#0F6E56"
                app:trackColorInactive="@color/border_tertiary"
                app:thumbRadius="7dp"
                app:trackHeight="4dp" />

            <!-- Section : Type de cuisine -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TYPE DE CUISINE"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupTypeCuisine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:chipSpacingHorizontal="4dp"
                app:chipSpacingVertical="3dp" />

        </LinearLayout>

    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/border_tertiary" />

    <!-- Pied du panneau : réinitialiser + appliquer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnReinitialiser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Réinitialiser"
            android:textSize="11sp"
            android:layout_marginEnd="8dp"
            app:cornerRadius="8dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <Button
            android:id="@+id/btnAppliquer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="Appliquer"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:backgroundTint="#0F6E56"
            app:cornerRadius="8dp"
            tools:text="Appliquer (8)" />

    </LinearLayout>

</LinearLayout>