<?xml version="1.0" encoding="utf-8"?>
<!-- res/color/chip_background_selector.xml
     Couleur de FOND des chips selon leur état coché / non coché.
     Utilisé dans tous les ChipGroup via :
         app:chipBackgroundColor="@color/chip_background_selector"  -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Coché → fond teal clair (#E1F5EE) -->
    <item
        android:color="@color/chip_checked_bg"
        android:state_checked="true" />

    <!-- Non coché (état par défaut) → fond blanc -->
    <item android:color="@color/chip_unchecked_bg" />

</selector>