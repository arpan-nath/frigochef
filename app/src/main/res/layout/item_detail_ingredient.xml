<?xml version="1.0" encoding="utf-8"?>
<!-- item_ingredient_detail.xml -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="6dp">

    <!-- Icône possédé / manquant -->
    <FrameLayout
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="10dp">

        <!-- Fond circulaire coloré -->
        <View
            android:id="@+id/viewIconBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_ingredient_icon"
            tools:backgroundTint="#EAF3DE" />

        <ImageView
            android:id="@+id/ivStatutIngredient"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_check"
            android:contentDescription="Statut"
            tools:tint="#3B6D11" />

    </FrameLayout>

    <!-- Nom de l'ingrédient -->
    <TextView
        android:id="@+id/tvNomIngredient"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="13sp"
        android:textColor="@color/text_primary"
        tools:text="Poulet" />

    <!-- Quantité + unité -->
    <TextView
        android:id="@+id/tvQuantiteIngredient"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/text_secondary"
        tools:text="600 g" />

</LinearLayout>